---
import Portal from "../layouts/Portal.astro";
import { getCurrentStudent, listNotices } from "../lib/db";

const student = getCurrentStudent();
const notices = listNotices(student.id);
---

<Portal title="Notices" active="Notices">
  <h1>Notices</h1>
  <p class="lede">
    General announcements alongside notices generated by your own actions — an enrolment change
    lands here too, instead of a separate inbox per system.
  </p>

  <ul class="notice-list">
    {
      notices.map((notice) => (
        <li>
          <span class="notice-category">{notice.category}</span>
          <strong>{notice.title}</strong>
          <p>{notice.body}</p>
          <time>{notice.createdAt}</time>
        </li>
      ))
    }
  </ul>
</Portal>
