---
import Portal from "../layouts/Portal.astro";
import { getCurrentStudent, listNotices } from "../lib/db";

const student = getCurrentStudent();
const notices = listNotices(student.id);

const byCategory = new Map<string, typeof notices>();
for (const notice of notices) {
  byCategory.set(notice.category, [...(byCategory.get(notice.category) ?? []), notice]);
}
---

<Portal title="Notices" active="Notices">
  <h1>Notices</h1>
  <p class="lede">
    General announcements alongside updates about your own account, such as a recent enrolment
    change.
  </p>

  {
    notices.length === 0 ? (
      <p class="empty">No notices yet.</p>
    ) : (
      [...byCategory.entries()].map(([category, categoryNotices]) => (
        <section class="content-group">
          <h2 class="notice-group-heading">{category}</h2>
          <ul class="notice-list">
            {categoryNotices.map((notice) => (
              <li>
                <strong class="notice-title">{notice.title}</strong>
                <p>{notice.body}</p>
                <time>{notice.createdAt}</time>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</Portal>
